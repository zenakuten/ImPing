{
  "name": "imping",
  "version": "0.2.0",
  "description": "A GUI application for visualizing ping latency over time",
  "dependencies": [
    {
      "name": "dbus",
      "default-features": false,
      "platform": "linux"
    },
    {
      "name": "imgui",
      "features": ["sdl3-binding", "sdl3-renderer-binding"]
    },
    {
      "name": "sdl3",
      "default-features": false,
      "features": ["wayland", "x11"]
    }
  ]
}
